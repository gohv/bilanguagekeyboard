<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        PolyBoard additions. All translatable="false": upstream ships ~100 locales and the app is
        built with lint.abortOnError=true, so a translatable string without translations fails the
        build on MissingTranslation. Revisit if this fork is ever actually distributed.
    -->

    <!-- toolbar key content descriptions. Names must match ToolbarKey entry names, lowercased. -->
    <string name="translate" translatable="false">Translate</string>
    <string name="translate_pair" translatable="false">Translation language pair</string>

    <!-- candidates strip states -->
    <string name="poly_undo" translatable="false">Undo</string>
    <string name="poly_translated" translatable="false">Translated %1$s → %2$s</string>
    <string name="poly_already_in" translatable="false">Already in %1$s</string>
    <string name="poly_preparing" translatable="false">Preparing translation…</string>
    <string name="poly_working" translatable="false">Translating…</string>

    <!-- translate key states / strip rows -->
    <string name="poly_model_missing" translatable="false">No model for %1$s → %2$s. Tap to set up</string>
    <string name="poly_needs_disclosure" translatable="false">Tap to set up translation</string>
    <string name="poly_tap_to_use" translatable="false">tap to use</string>

    <!-- first-run disclosure -->
    <string name="poly_disclosure_title" translatable="false">How translation works</string>
    <string name="poly_disclosure_accept" translatable="false">I understand, continue</string>

    <!-- model management -->
    <string name="poly_models_title" translatable="false">Translation</string>
    <string name="poly_models_heading" translatable="false">Languages</string>
    <string name="poly_models_size_note" translatable="false">Each language is roughly %1$d MB. That is the figure Google publishes, not a measurement: ML Kit does not report actual size on disk.</string>
    <string name="poly_model_ready" translatable="false">on device, ~%1$d MB</string>
    <string name="poly_model_absent" translatable="false">not downloaded</string>
    <string name="poly_download" translatable="false">Download</string>
    <string name="poly_delete" translatable="false">Delete</string>
    <string name="poly_downloading" translatable="false">Downloading %1$s…</string>
    <string name="poly_download_failed" translatable="false">Download failed: %1$s</string>
    <string name="poly_delete_failed" translatable="false">Could not delete that model</string>
    <string name="poly_loading" translatable="false">Checking which models are on the device…</string>
    <string name="poly_no_models_yet" translatable="false">No models yet. Download the languages you type in, and English, since every model translates to and from English.</string>
    <string name="poly_unmetered_only" translatable="false">Download models on Wi-Fi only</string>
    <string name="poly_live_preview" translatable="false">Show translation instead of word suggestions</string>
    <string name="poly_live_preview_hint" translatable="false">As you type, the translation appears in the suggestion strip; tap it to replace your text. You lose word suggestions and autocorrect while it is showing, and it runs many more translations than the translate key does.</string>
    <string name="poly_allow_incognito" translatable="false">Translate in private-keyboard apps (Signal, Molly)</string>
    <string name="poly_allow_incognito_hint" translatable="false">These apps ask keyboards not to learn from what you type. PolyBoard never saves your text anywhere, so it honours that either way. Turn this off to also stop translating in those apps. Password, email, URL, phone and number fields stay blocked regardless.</string>
    <string name="poly_use_stub" translatable="false">Use the fake test engine</string>
    <string name="poly_stub_active" translatable="false">The fake engine uppercases your text and prefixes the target language. Nothing is translated and no model is used.</string>
    <string name="poly_mlkit_attribution" translatable="false">Translation powered by Google ML Kit, running on this device.</string>

    <!-- debug -->
    <string name="prefs_poly_field_overlay" translatable="false">Show field type in suggestion strip</string>
    <string name="prefs_poly_field_overlay_summary" translatable="false">PolyBoard: shows package name, decoded inputType and imeOptions when a field is opened</string>
</resources>
